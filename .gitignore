# ==============================================================================
# Database & Caches (Preserve folder structure via .gitkeep)
# ==============================================================================
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
!database/schema.sql
!database/.gitkeep

data/cache/covers/*
!data/cache/covers/.gitkeep
data/cache/pdf_pages/*
!data/cache/pdf_pages/.gitkeep

# Prevent committing large user manga/PDF library files (>100MB)
data/library/*/*
!data/library/**/.gitkeep
!data/library/manga/.gitkeep
!data/library/document/.gitkeep

# ==============================================================================
# Environment Variables & Secrets
# ==============================================================================
.env
.env.local
.env.*.local
*.env

